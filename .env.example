# LifePilot / StepNext Environment Configuration

# Gemini AI API Key (Required for live Gemini AI responses, falls back to deterministic engine if omitted)
GEMINI_API_KEY=
API_KEY=

# Supabase Postgres Configuration (Optional - application falls back to dummy fixture if omitted)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key

# Server Port Configuration
PORT=8000
